RewriteEngine On

# Redirect HTTP to HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# Redirect non-www to www (canonical host)
RewriteCond %{HTTP_HOST} ^shaytechsolutions\.com$ [NC]
RewriteRule ^(.*)$ https://www.shaytechsolutions.com/$1 [R=301,L]

# ─── Redesign (2026-09): retired routes -> new sitemap ──────────
# output:'export' means next.config's redirects() is a no-op (Node/Vercel-only), so these
# live here instead. Old page files under app/services/* and app/aboutme are left in place
# unpublished/unlinked rather than deleted this pass — see the redesign plan.
RewriteRule ^aboutme/?$ /about [R=301,L]
RewriteRule ^services/estore/?$ /project [R=301,L]
RewriteRule ^services/website/?$ /project [R=301,L]
RewriteRule ^services/custom-development/?$ /project [R=301,L]
RewriteRule ^services/hosting/?$ /plans [R=301,L]
RewriteRule ^services/advertising/?$ /plans [R=301,L]
RewriteRule ^services/?$ /plans [R=301,L]

# ─── Security headers ───────────────────────────────────────────
<IfModule mod_headers.c>
    # Force HTTPS for one year, include subdomains, allow HSTS preload
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Stop MIME-sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Block being iframed (clickjacking)
    Header always set X-Frame-Options "SAMEORIGIN"

    # Don't leak full URLs as referrer to third parties
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Lock down browser features we don't use
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"

    # Cross-origin policies
    Header always set Cross-Origin-Opener-Policy "same-origin"
</IfModule>
